---
import { toolRoutes } from "@/data/tools";
---

<section class="tool-band" aria-labelledby="tools-title">
  <div class="shell">
    <div class="section-heading">
      <p>Tool Routes</p>
      <h2 id="tools-title">Use focused tools in one place.</h2>
    </div>
    <div class="tool-grid">
      {
        toolRoutes.map((tool) => (
          <a class={`tool-card ${tool.accent} focus-ring`} href={tool.href}>
            <span>{tool.status}</span>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
            <small>Open route -></small>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tool-band {
    padding: 84px 0 20px;
  }

  .section-heading {
    max-width: 640px;
  }

  .section-heading p {
    color: var(--ink);
    font-size: 13px;
    font-weight: 950;
    letter-spacing: 0;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .section-heading h2 {
    font-size: clamp(40px, 7vw, 78px);
    font-weight: 950;
    letter-spacing: 0;
    line-height: 1;
    margin: 0 0 28px;
  }

  .tool-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .tool-card {
    background: var(--surface);
    border: 1px solid #cfd6cf;
    border-radius: 8px;
    box-shadow: 0 20px 70px rgba(7, 9, 9, 0.05);
    min-height: 214px;
    padding: 22px;
    position: relative;
    transition:
      border-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .tool-card:hover {
    border-color: rgba(7, 9, 9, 0.35);
    box-shadow: 0 28px 80px rgba(7, 9, 9, 0.1);
    transform: translateY(-3px);
  }

  .tool-card span {
    background: var(--mint);
    border: 0;
    border-radius: 999px;
    color: var(--muted);
    display: inline-flex;
    font-size: 12px;
    font-weight: 950;
    margin-bottom: 28px;
    padding: 5px 9px;
    text-transform: uppercase;
  }

  .tool-card h3 {
    font-size: 22px;
    font-weight: 950;
    letter-spacing: 0;
    margin: 0 0 9px;
  }

  .tool-card p {
    color: var(--muted);
    line-height: 1.55;
    margin: 0;
  }

  .tool-card small {
    bottom: 20px;
    color: var(--ink);
    font-size: 13px;
    font-weight: 950;
    left: 22px;
    position: absolute;
    text-transform: uppercase;
  }

  .tool-card.mint {
    border-top: 4px solid var(--mint);
  }

  .tool-card.coral {
    border-top: 4px solid var(--coral);
  }

  .tool-card.blue {
    border-top: 4px solid var(--blue);
  }

  .tool-card.gold {
    border-top: 4px solid var(--gold);
  }

  @media (max-width: 900px) {
    .tool-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
