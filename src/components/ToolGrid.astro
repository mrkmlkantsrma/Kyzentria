---
import { toolRoutes } from "@/data/tools";
---

<section class="tool-band" id="tools" aria-labelledby="tools-title">
  <div class="shell">
    <div class="section-heading reveal">
      <p class="mono">Tool Routes</p>
      <h2 id="tools-title">Pick a tool and finish the task.</h2>
    </div>
    <div class="tool-grid reveal">
      {
        toolRoutes.map((tool) => (
          <a class={`tool-card ${tool.accent} focus-ring`} href={tool.href}>
            <span>{tool.status}</span>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
            <small>Open route -></small>
          </a>
        ))
      }
    </div>
  </div>
</section>

<style>
  .tool-band {
    background: color-mix(in srgb, var(--paper), var(--brand-green) 8%);
    border-top: 1px solid var(--line);
    padding: 100px 0 30px;
  }

  .section-heading {
    max-width: 640px;
  }

  .section-heading p {
    color: var(--mint);
    font-size: 13px;
    font-weight: 950;
    letter-spacing: 0;
    margin: 0 0 10px;
    text-transform: uppercase;
  }

  .section-heading h2 {
    font-size: clamp(40px, 7vw, 82px);
    font-weight: 950;
    letter-spacing: 0;
    line-height: 1;
    margin: 0 0 28px;
  }

  .tool-grid {
    display: grid;
    gap: 14px;
    grid-template-columns: repeat(3, minmax(0, 1fr));
  }

  .tool-card {
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface), transparent 4%), color-mix(in srgb, var(--surface), var(--brand-green) 14%));
    border: 1px solid var(--line);
    border-radius: 8px;
    box-shadow: 0 24px 80px rgba(0, 0, 0, 0.14);
    min-height: 248px;
    overflow: hidden;
    padding: 24px;
    position: relative;
    transition:
      border-color 160ms ease,
      transform 160ms ease,
      box-shadow 160ms ease;
  }

  .tool-card:hover {
    border-color: rgba(55, 224, 160, 0.5);
    box-shadow: 0 28px 90px rgba(55, 224, 160, 0.1);
    transform: translateY(-5px);
  }

  .tool-card::after {
    background: radial-gradient(circle, rgba(55, 224, 160, 0.24), transparent 62%);
    content: "";
    height: 160px;
    opacity: 0;
    position: absolute;
    right: -70px;
    top: -70px;
    transition: opacity 180ms ease;
    width: 160px;
  }

  .tool-card:hover::after {
    opacity: 1;
  }

  .tool-card span {
    background: var(--mint);
    border: 0;
    border-radius: 999px;
    color: var(--paper);
    display: inline-flex;
    font-size: 12px;
    font-weight: 950;
    margin-bottom: 28px;
    padding: 5px 9px;
    text-transform: uppercase;
  }

  .tool-card h3 {
    color: var(--ink);
    font-size: 26px;
    font-weight: 950;
    letter-spacing: 0;
    margin: 0 0 9px;
  }

  .tool-card p {
    color: var(--muted);
    line-height: 1.55;
    margin: 0;
  }

  .tool-card small {
    bottom: 20px;
    color: var(--mint);
    font-size: 13px;
    font-weight: 950;
    left: 22px;
    position: absolute;
    text-transform: uppercase;
  }

  .tool-card.mint {
    border-top: 3px solid var(--mint);
  }

  .tool-card.coral {
    border-top: 3px solid var(--coral);
  }

  .tool-card.blue {
    border-top: 3px solid var(--blue);
  }

  .tool-card.gold {
    border-top: 3px solid var(--gold);
  }

  @media (max-width: 900px) {
    .tool-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 620px) {
    .tool-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
