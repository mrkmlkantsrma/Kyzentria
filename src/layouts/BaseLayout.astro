---
import "../styles/global.css";
import { toolRoutes } from "@/data/tools";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Kyzentria - Smart tools for everyday work",
  description = "Kyzentria is a growing collection of fast, free browser tools for calculators, PDFs, images, SEO, resumes, comparisons, and developer work.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary_large_image" />
  </head>
  <body>
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand focus-ring" href="/" aria-label="Kyzentria home">
          <span class="brand-mark">K</span>
          <span>Kyzentria</span>
        </a>
        <nav class="nav" aria-label="Main navigation">
          {toolRoutes.slice(0, 6).map((tool) => <a class="focus-ring" href={tool.href}>{tool.title}</a>)}
        </nav>
        <a class="header-cta focus-ring" href="/calculator">Open tools</a>
      </div>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="shell footer-grid">
        <div>
          <strong>Kyzentria</strong>
          <p>Smart tools for everyday work.</p>
        </div>
        <div class="footer-links">
          <a class="focus-ring" href="/seo">SEO</a>
          <a class="focus-ring" href="/hosting">Hosting</a>
          <a class="focus-ring" href="/developer">Developer</a>
        </div>
      </div>
    </footer>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    border-bottom: 1px solid rgba(7, 9, 9, 0.1);
    background: rgba(248, 251, 246, 0.92);
    backdrop-filter: blur(14px);
  }

  .header-inner {
    align-items: center;
    display: flex;
    gap: 24px;
    justify-content: space-between;
    min-height: 72px;
  }

  .brand {
    align-items: center;
    display: inline-flex;
    font-size: 20px;
    font-weight: 950;
    gap: 10px;
    letter-spacing: 0;
  }

  .brand-mark {
    align-items: center;
    background: var(--ink);
    border-radius: 8px;
    color: white;
    display: inline-flex;
    height: 34px;
    justify-content: center;
    width: 34px;
  }

  .nav {
    align-items: center;
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    justify-content: flex-end;
  }

  .nav a {
    border-radius: 8px;
    color: var(--muted);
    font-size: 14px;
    font-weight: 850;
    padding: 10px 11px;
  }

  .nav a:hover {
    background: var(--mist);
    color: var(--ink);
  }

  .header-cta {
    align-items: center;
    background: var(--ink);
    border-radius: 8px;
    color: white;
    display: inline-flex;
    font-size: 14px;
    font-weight: 900;
    min-height: 42px;
    padding: 0 14px;
    white-space: nowrap;
  }

  .site-footer {
    border-top: 1px solid var(--line);
    margin-top: 80px;
    padding: 34px 0;
  }

  .footer-grid {
    align-items: center;
    display: flex;
    gap: 24px;
    justify-content: space-between;
  }

  .footer-grid p {
    color: var(--muted);
    margin: 6px 0 0;
  }

  .footer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 14px;
  }

  .footer-links a {
    color: var(--muted);
    font-weight: 850;
  }

  @media (max-width: 760px) {
    .header-inner,
    .footer-grid {
      align-items: flex-start;
      flex-direction: column;
      justify-content: flex-start;
      padding-bottom: 16px;
      padding-top: 16px;
    }

    .nav {
      justify-content: flex-start;
    }

    .header-cta {
      display: none;
    }
  }
</style>
