---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Resume Tools - Kyzentria" description="Check resume keywords, readability, and basic structure with Kyzentria resume tools.">
  <section class="shell tool-page">
    <div class="tool-intro">
      <p class="tool-kicker">Resume</p>
      <h1 class="tool-title">Resume keyword checker.</h1>
      <span class="tool-lede">Paste a job description and resume text to see keyword matches and gaps.</span>
    </div>

    <div class="tool-layout">
      <section class="tool-surface">
        <div class="tool-header">
          <h2>Keyword Match</h2>
          <span class="tool-badge">Private</span>
        </div>
        <div class="field-grid">
          <label class="tool-field">
            <span>Job description</span>
            <textarea id="job-text" class="focus-ring">SEO content, analytics, JavaScript, reporting, communication, project management</textarea>
          </label>
          <label class="tool-field">
            <span>Resume text</span>
            <textarea id="resume-text" class="focus-ring">Built JavaScript tools, reviewed analytics, wrote SEO content, and managed project reporting.</textarea>
          </label>
        </div>
        <button id="check-resume" class="tool-button focus-ring" type="button">Check match</button>
        <div class="result-box">
          <span>Match Score</span>
          <strong id="resume-score">0%</strong>
          <p id="resume-note">Paste both texts to check the match.</p>
        </div>
        <div class="preview-box">
          <strong>Missing keywords</strong>
          <p id="missing-keywords" class="muted-copy">None yet.</p>
        </div>
      </section>

      <aside class="tool-aside">
        <h2>Privacy note</h2>
        <p>This first version runs in the browser. Do not paste sensitive personal data into public tools unless you are comfortable with the page context.</p>
        <div class="note-list">
          <span>Useful free tool</span>
          <span>Template upsell later</span>
          <span>Resume-builder affiliate fit</span>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline>
    const job = document.getElementById("job-text");
    const resume = document.getElementById("resume-text");
    const score = document.getElementById("resume-score");
    const note = document.getElementById("resume-note");
    const missing = document.getElementById("missing-keywords");

    function keywords(text) {
      return [...new Set(text.toLowerCase().match(/[a-z][a-z+#.-]{2,}/g) || [])]
        .filter((word) => !["and", "the", "for", "with", "this", "that", "you", "your"].includes(word));
    }

    function checkResume() {
      const jobWords = keywords(job.value);
      const resumeText = resume.value.toLowerCase();
      const matched = jobWords.filter((word) => resumeText.includes(word));
      const missed = jobWords.filter((word) => !resumeText.includes(word));
      const percent = jobWords.length ? Math.round((matched.length / jobWords.length) * 100) : 0;
      score.textContent = `${percent}%`;
      note.textContent = `${matched.length} of ${jobWords.length} job keywords appear in the resume text.`;
      missing.textContent = missed.length ? missed.join(", ") : "No major gaps found.";
    }

    document.getElementById("check-resume").addEventListener("click", checkResume);
    [job, resume].forEach((item) => item.addEventListener("input", checkResume));
    checkResume();
  </script>
</BaseLayout>
