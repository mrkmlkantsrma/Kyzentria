---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ToolGrid from "@/components/ToolGrid.astro";
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Kyzentria</p>
        <h1>Smart tools for everyday work.</h1>
        <p class="lede">
          Fast, focused browser tools for calculators, PDFs, images, SEO, resumes,
          comparisons, prompts, hosting, and developer tasks.
        </p>
        <div class="hero-actions">
          <a class="primary focus-ring" href="/calculator">Explore tools</a>
          <a class="secondary focus-ring" href="/compare">View comparisons</a>
        </div>
      </div>
      <div class="hero-panel" aria-label="Kyzentria tool categories">
        <div class="panel-row">
          <span>Calculator</span>
          <strong>Money, units, percentages</strong>
        </div>
        <div class="panel-row">
          <span>PDF</span>
          <strong>Convert, compress, organize</strong>
        </div>
        <div class="panel-row">
          <span>Image</span>
          <strong>Resize, convert, optimize</strong>
        </div>
        <div class="panel-row">
          <span>SEO</span>
          <strong>Titles, metadata, checks</strong>
        </div>
      </div>
    </div>
  </section>
  <ToolGrid />
</BaseLayout>

<style>
  .hero {
    background:
      linear-gradient(135deg, rgba(143, 215, 189, 0.34), transparent 38%),
      linear-gradient(225deg, rgba(238, 123, 96, 0.18), transparent 36%),
      var(--paper);
    border-bottom: 1px solid rgba(23, 32, 31, 0.08);
    padding: 86px 0 62px;
  }

  .hero-grid {
    align-items: center;
    display: grid;
    gap: 48px;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
  }

  .eyebrow {
    color: var(--coral);
    font-size: 13px;
    font-weight: 850;
    letter-spacing: 0;
    margin: 0 0 14px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(44px, 8vw, 88px);
    letter-spacing: 0;
    line-height: 0.94;
    margin: 0;
    max-width: 780px;
  }

  .lede {
    color: var(--muted);
    font-size: clamp(18px, 2.4vw, 22px);
    line-height: 1.55;
    margin: 26px 0 0;
    max-width: 660px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .primary,
  .secondary {
    align-items: center;
    border-radius: 8px;
    display: inline-flex;
    font-weight: 800;
    min-height: 48px;
    padding: 0 18px;
  }

  .primary {
    background: var(--ink);
    color: white;
  }

  .secondary {
    background: white;
    border: 1px solid var(--line);
  }

  .hero-panel {
    background: rgba(255, 255, 255, 0.72);
    border: 1px solid rgba(23, 32, 31, 0.12);
    border-radius: 8px;
    box-shadow: 0 24px 70px rgba(23, 32, 31, 0.1);
    padding: 14px;
  }

  .panel-row {
    align-items: center;
    border-bottom: 1px solid var(--line);
    display: grid;
    gap: 16px;
    grid-template-columns: 120px 1fr;
    min-height: 74px;
    padding: 12px;
  }

  .panel-row:last-child {
    border-bottom: 0;
  }

  .panel-row span {
    color: var(--muted);
    font-size: 14px;
    font-weight: 750;
  }

  .panel-row strong {
    font-size: 18px;
  }

  @media (max-width: 860px) {
    .hero {
      padding-top: 58px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .panel-row {
      grid-template-columns: 1fr;
    }
  }
</style>
