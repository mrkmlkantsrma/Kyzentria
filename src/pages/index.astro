---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ToolGrid from "@/components/ToolGrid.astro";
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Your browser toolkit</p>
        <h1>Your work. Minus the friction.</h1>
        <p class="lede">
          Kyzentria gives you fast, focused tools for calculations, documents,
          images, SEO, resumes, comparisons, prompts, hosting, and developer work.
        </p>
        <div class="hero-actions">
          <a class="primary focus-ring" href="/calculator">Try calculator</a>
          <a class="secondary focus-ring" href="/compare">View comparisons</a>
        </div>
      </div>
      <div class="hero-panel" aria-label="Kyzentria live tool console">
        <div class="console-top">
          <span>kyzentria.tools</span>
          <strong>live</strong>
        </div>
        <div class="console-line"><span>RESOLVES</span><strong>Percentages, discounts, margins</strong></div>
        <div class="console-line"><span>FORMATS</span><strong>JSON, prompts, metadata</strong></div>
        <div class="console-line"><span>CHECKS</span><strong>Resume keywords and SEO snippets</strong></div>
        <div class="console-line"><span>OPTIMIZES</span><strong>Images, PDFs, hosting costs</strong></div>
        <div class="console-foot">
          <span>$</span>
          <p>tools ready. choose a route.</p>
        </div>
      </div>
    </div>
  </section>
  <ToolGrid />
</BaseLayout>

<style>
  .hero {
    background:
      radial-gradient(circle at 15% 16%, rgba(202, 255, 90, 0.28), transparent 25%),
      linear-gradient(110deg, #f7f7f1 0%, #f7f7f1 58%, #eeeeea 100%);
    border-bottom: 1px solid rgba(7, 9, 9, 0.1);
    padding: 104px 0 74px;
  }

  .hero-grid {
    align-items: center;
    display: grid;
    gap: 48px;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
  }

  .eyebrow {
    color: var(--coral);
    font-size: 13px;
    font-weight: 950;
    letter-spacing: 0;
    margin: 0 0 14px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(56px, 9vw, 112px);
    font-weight: 950;
    letter-spacing: 0;
    line-height: 0.88;
    margin: 0;
    max-width: 780px;
  }

  .lede {
    color: var(--muted);
    font-size: clamp(19px, 2.4vw, 23px);
    line-height: 1.55;
    margin: 26px 0 0;
    max-width: 660px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .primary,
  .secondary {
    align-items: center;
    border-radius: 8px;
    display: inline-flex;
    font-weight: 950;
    min-height: 48px;
    padding: 0 18px;
  }

  .primary {
    background: var(--ink);
    color: white;
  }

  .secondary {
    background: transparent;
    border: 1px solid rgba(7, 9, 9, 0.18);
  }

  .hero-panel {
    background: var(--dark-panel);
    border: 1px solid rgba(7, 9, 9, 0.24);
    border-radius: 8px;
    box-shadow: 0 28px 80px rgba(7, 9, 9, 0.18);
    color: white;
    padding: 18px;
  }

  .console-top,
  .console-line,
  .console-foot {
    align-items: center;
    border-bottom: 1px solid rgba(255, 255, 255, 0.12);
    display: grid;
    gap: 16px;
    grid-template-columns: 124px 1fr;
    min-height: 74px;
    padding: 12px;
  }

  .console-top {
    color: var(--mint);
    min-height: 44px;
  }

  .console-top strong {
    background: var(--mint);
    border-radius: 999px;
    color: var(--ink);
    font-size: 12px;
    justify-self: end;
    padding: 5px 9px;
    text-transform: uppercase;
  }

  .console-line span,
  .console-foot span {
    color: var(--mint);
    font-size: 13px;
    font-weight: 950;
  }

  .console-line strong {
    font-size: 18px;
  }

  .console-foot {
    border-bottom: 0;
    color: rgba(255, 255, 255, 0.76);
    min-height: 54px;
  }

  @media (max-width: 860px) {
    .hero {
      padding-top: 58px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .console-line,
    .console-foot {
      grid-template-columns: 1fr;
    }
  }
</style>
