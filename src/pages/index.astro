---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ToolGrid from "@/components/ToolGrid.astro";
---

<BaseLayout>
  <section class="hero">
    <div class="shell hero-grid">
      <div class="hero-copy">
        <p class="eyebrow">Free web tools</p>
        <h1>Small tools for quick tasks.</h1>
        <p class="lede">
          Kyzentria brings calculators, file helpers, SEO checks, resume matching,
          prompt builders, and developer utilities into one clean browser workspace.
        </p>
        <div class="hero-actions">
          <a class="primary focus-ring" href="/calculator">Try calculator</a>
          <a class="secondary focus-ring" href="/compare">View comparisons</a>
        </div>
      </div>
      <div class="hero-panel" aria-label="Kyzentria tool summary">
        <div class="summary-card main">
          <span>Available now</span>
          <strong>9</strong>
          <p>working browser tools</p>
        </div>
        <div class="summary-card">
          <span>Popular start</span>
          <strong>Calculator</strong>
          <p>percent, discount, margin</p>
        </div>
        <div class="summary-card">
          <span>Privacy</span>
          <strong>Local</strong>
          <p>many tools run in your browser</p>
        </div>
        <div class="summary-card">
          <span>Next focus</span>
          <strong>Content</strong>
          <p>SEO pages and guides</p>
        </div>
      </div>
    </div>
  </section>
  <ToolGrid />
</BaseLayout>

<style>
  .hero {
    background:
      radial-gradient(circle at 15% 16%, rgba(128, 216, 178, 0.28), transparent 26%),
      radial-gradient(circle at 88% 22%, rgba(242, 121, 92, 0.16), transparent 24%),
      linear-gradient(110deg, #f8fbf6 0%, #f8fbf6 60%, #f0f5ef 100%);
    border-bottom: 1px solid rgba(7, 9, 9, 0.1);
    padding: 96px 0 74px;
  }

  .hero-grid {
    align-items: center;
    display: grid;
    gap: 48px;
    grid-template-columns: minmax(0, 1.08fr) minmax(320px, 0.92fr);
  }

  .eyebrow {
    color: var(--coral);
    font-size: 13px;
    font-weight: 950;
    letter-spacing: 0;
    margin: 0 0 14px;
    text-transform: uppercase;
  }

  h1 {
    font-size: clamp(50px, 8vw, 94px);
    font-weight: 900;
    letter-spacing: 0;
    line-height: 0.96;
    margin: 0;
    max-width: 780px;
  }

  .lede {
    color: var(--muted);
    font-size: clamp(19px, 2.4vw, 23px);
    line-height: 1.55;
    margin: 26px 0 0;
    max-width: 660px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    margin-top: 32px;
  }

  .primary,
  .secondary {
    align-items: center;
    border-radius: 8px;
    display: inline-flex;
    font-weight: 950;
    min-height: 48px;
    padding: 0 18px;
  }

  .primary {
    background: var(--ink);
    color: white;
  }

  .secondary {
    background: transparent;
    border: 1px solid rgba(7, 9, 9, 0.18);
  }

  .hero-panel {
    background: rgba(255, 255, 255, 0.78);
    border: 1px solid rgba(22, 33, 31, 0.12);
    border-radius: 8px;
    box-shadow: 0 28px 80px rgba(22, 33, 31, 0.08);
    color: var(--ink);
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    padding: 14px;
  }

  .summary-card {
    background: white;
    border: 1px solid var(--line);
    border-radius: 8px;
    min-height: 148px;
    padding: 18px;
  }

  .summary-card.main {
    background: var(--ink);
    color: white;
    grid-row: span 2;
  }

  .summary-card span {
    color: var(--coral);
    display: block;
    font-size: 12px;
    font-weight: 900;
    margin-bottom: 22px;
    text-transform: uppercase;
  }

  .summary-card.main span {
    color: var(--mint);
  }

  .summary-card strong {
    display: block;
    font-size: clamp(28px, 4vw, 52px);
    line-height: 1;
  }

  .summary-card p {
    color: var(--muted);
    line-height: 1.45;
    margin: 12px 0 0;
  }

  .summary-card.main p {
    color: rgba(255, 255, 255, 0.72);
  }

  @media (max-width: 860px) {
    .hero {
      padding-top: 58px;
    }

    .hero-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 520px) {
    .hero-panel {
      grid-template-columns: 1fr;
    }
  }
</style>
