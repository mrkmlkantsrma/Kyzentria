---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ToolGrid from "@/components/ToolGrid.astro";
---

<BaseLayout>
  <section class="hero">
    <div class="ambient ambient-a"></div>
    <div class="ambient ambient-b"></div>
    <div class="shell hero-inner">
      <div class="tool-orb reveal" aria-label="Kyzentria tool core">
        <span>your web</span>
        <strong>Toolkit</strong>
      </div>
      <div class="hero-copy reveal">
        <p class="eyebrow mono">Browser tools infrastructure</p>
        <h1>Useful tools. <span class="serif-accent">Ready</span> when you are.</h1>
        <p class="lede">
          Kyzentria is a fast static workspace for calculators, files, SEO checks,
          resume matching, prompts, comparisons, hosting estimates, and developer utilities.
        </p>
        <div class="hero-actions">
          <a class="primary focus-ring" href="/calculator">Start with calculator</a>
          <a class="secondary focus-ring" href="#tools">See all tools</a>
        </div>
      </div>
      <p class="scroll-cue mono">Scroll</p>
    </div>
  </section>

  <section class="verb-strip" aria-label="Kyzentria capabilities">
    <div class="shell verb-grid reveal">
      <span>Calculates</span>
      <span>Formats</span>
      <span>Checks</span>
      <span>Optimizes</span>
      <span>Compares</span>
      <span>Builds</span>
    </div>
  </section>

  <section class="workflow-section">
    <div class="shell workflow-grid">
      <div class="workflow-copy reveal">
        <p class="eyebrow mono">Tool workspace</p>
        <h2>Open one route. Finish one job.</h2>
        <p>
          Each Kyzentria page is built around a small result: calculate a value,
          inspect a file, preview metadata, score options, or build a reusable prompt.
        </p>
        <ul>
          <li><strong>Pick</strong> the tool route for the task.</li>
          <li><strong>Use</strong> the browser-side function.</li>
          <li><strong>Expand</strong> with guides, SEO pages, and monetization later.</li>
        </ul>
      </div>
      <div class="terminal-card reveal" aria-label="Live tool feed">
        <div class="terminal-top">
          <span></span><span></span><span></span>
          <strong class="mono">kyzentria.tools - live</strong>
        </div>
        <div class="terminal-body mono">
          <p><span>14:02:11</span> calculator opened - percent mode ready</p>
          <p><span>14:02:17</span> image optimizer waiting for local file</p>
          <p><span>14:02:24</span> seo preview validated title length</p>
          <p><span>14:02:31</span> json formatter parsed clean input</p>
          <p><span>14:02:39</span> resume checker matched 6 keywords</p>
          <p><span>14:02:45</span> hosting estimator calculated yearly cost</p>
          <p><span>$</span> choose a tool route...</p>
        </div>
      </div>
    </div>
  </section>

  <ToolGrid />

  <section class="metrics-section">
    <div class="shell">
      <div class="section-head reveal">
        <p class="eyebrow mono">Project base</p>
        <h2>Built for static growth.</h2>
      </div>
      <div class="metric-grid reveal">
        <article>
          <span class="mono">TOOLS LIVE</span>
          <strong>9</strong>
          <p>Core browser utilities are ready as route pages.</p>
        </article>
        <article>
          <span class="mono">BACKEND</span>
          <strong>0</strong>
          <p>No database or server is needed for the first phase.</p>
        </article>
        <article>
          <span class="mono">DEPLOYMENT</span>
          <strong>Pages</strong>
          <p>Cloudflare Pages deploys from GitHub on every push.</p>
        </article>
        <article>
          <span class="mono">REVENUE</span>
          <strong>Later</strong>
          <p>Affiliate guides, ads, and sponsored placements come after traffic.</p>
        </article>
      </div>
    </div>
  </section>

  <section class="cta-section">
    <div class="pattern" aria-hidden="true"></div>
    <div class="shell cta-inner reveal">
      <h2>Ready to make the next tool useful?</h2>
      <p>Start with high-intent pages, then build content and monetization around what people actually use.</p>
      <div class="hero-actions">
        <a class="primary focus-ring" href="/seo">Open SEO preview</a>
        <a class="secondary focus-ring" href="/hosting">Estimate hosting</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    background:
      linear-gradient(180deg, rgba(19, 71, 49, 0.34), transparent 34%),
      radial-gradient(circle at 50% 18%, rgba(55, 224, 160, 0.16), transparent 18rem),
      var(--paper);
    border-bottom: 1px solid var(--line);
    min-height: calc(100vh - 72px);
    overflow: hidden;
    position: relative;
  }

  .hero-inner {
    align-items: center;
    display: grid;
    justify-items: center;
    min-height: calc(100vh - 72px);
    padding-bottom: 34px;
    padding-top: 34px;
    position: relative;
    text-align: center;
  }

  .ambient {
    border: 1px solid rgba(55, 224, 160, 0.28);
    border-radius: 999px;
    position: absolute;
  }

  .ambient::before {
    background: var(--mint);
    border-radius: 999px;
    content: "";
    height: 8px;
    left: -4px;
    position: absolute;
    top: -4px;
    width: 8px;
  }

  .ambient-a {
    animation: drift 9s ease-in-out infinite;
    height: 46px;
    left: 10%;
    top: 12%;
    width: 46px;
  }

  .ambient-b {
    animation: drift 12s ease-in-out infinite reverse;
    bottom: 10%;
    height: 34px;
    right: 18%;
    width: 34px;
  }

  .tool-orb {
    align-items: center;
    animation: pulseGlow 5s ease-in-out infinite;
    background:
      radial-gradient(circle at 34% 28%, rgba(55, 224, 160, 0.24), transparent 34%),
      radial-gradient(circle at 64% 70%, rgba(19, 71, 49, 0.9), transparent 60%),
      #050d09;
    border: 1px solid rgba(55, 224, 160, 0.34);
    border-radius: 999px;
    display: flex;
    flex-direction: column;
    height: clamp(176px, 22vw, 270px);
    justify-content: center;
    margin-bottom: 34px;
    width: clamp(176px, 22vw, 270px);
  }

  .tool-orb span {
    color: var(--muted);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tool-orb strong {
    color: #fff;
    font-size: clamp(30px, 4vw, 48px);
    line-height: 1;
    margin-top: 12px;
  }

  .eyebrow {
    color: var(--mint);
    font-size: 13px;
    font-weight: 900;
    letter-spacing: 0.18em;
    margin: 0 0 28px;
    text-transform: uppercase;
  }

  h1 {
    color: var(--ink);
    font-size: clamp(54px, 9vw, 118px);
    font-weight: 950;
    letter-spacing: 0;
    line-height: 0.88;
    margin: 0 auto;
    max-width: 880px;
  }

  h1 .serif-accent,
  .workflow-copy h2 .serif-accent {
    color: var(--mint);
  }

  .lede {
    color: var(--muted);
    font-size: clamp(18px, 2.2vw, 22px);
    line-height: 1.6;
    margin: 26px auto 0;
    max-width: 760px;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
    justify-content: center;
    margin-top: 32px;
  }

  .primary,
  .secondary {
    align-items: center;
    border-radius: 8px;
    display: inline-flex;
    font-weight: 900;
    min-height: 54px;
    padding: 0 22px;
  }

  .primary {
    background: var(--ink);
    color: var(--paper);
  }

  .secondary {
    background: transparent;
    border: 1px solid var(--line);
    color: var(--ink);
  }

  :global([data-theme="dark"]) .primary {
    background: #f5faf6;
    color: #07110d;
  }

  .scroll-cue {
    bottom: 20px;
    color: var(--muted);
    font-size: 12px;
    font-weight: 900;
    left: 50%;
    letter-spacing: 0.28em;
    position: absolute;
    text-transform: uppercase;
    transform: translateX(-50%);
  }

  .verb-strip {
    border-bottom: 1px solid var(--line);
    border-top: 1px solid var(--line);
    background: color-mix(in srgb, var(--brand-green), transparent 72%);
    padding: 22px 0;
  }

  .verb-grid {
    display: grid;
    gap: 10px;
    grid-template-columns: repeat(6, minmax(0, 1fr));
  }

  .verb-grid span {
    color: var(--mint);
    font-family: "SFMono-Regular", Consolas, "Liberation Mono", monospace;
    font-size: 13px;
    font-weight: 900;
    text-align: center;
    text-transform: uppercase;
  }

  .workflow-section,
  .metrics-section {
    padding: 100px 0;
  }

  .workflow-grid {
    align-items: center;
    display: grid;
    gap: 70px;
    grid-template-columns: minmax(0, 0.9fr) minmax(360px, 1.1fr);
  }

  .workflow-copy h2,
  .section-head h2,
  .cta-inner h2 {
    font-size: clamp(40px, 7vw, 82px);
    font-weight: 950;
    letter-spacing: 0;
    line-height: 0.95;
    margin: 0;
  }

  .workflow-copy p,
  .cta-inner p {
    color: var(--muted);
    font-size: 18px;
    line-height: 1.7;
    margin: 26px 0 0;
  }

  .workflow-copy ul {
    display: grid;
    gap: 18px;
    list-style: none;
    margin: 34px 0 0;
    padding: 0;
  }

  .workflow-copy li {
    color: var(--muted);
    line-height: 1.55;
    padding-left: 28px;
    position: relative;
  }

  .workflow-copy li::before {
    background: var(--mint);
    border-radius: 999px;
    content: "";
    height: 8px;
    left: 0;
    position: absolute;
    top: 8px;
    width: 8px;
  }

  .workflow-copy strong {
    color: var(--ink);
  }

  .terminal-card {
    background: #050d09;
    border: 1px solid rgba(55, 224, 160, 0.22);
    border-radius: 8px;
    box-shadow: 0 26px 90px rgba(0, 0, 0, 0.28);
    overflow: hidden;
    position: relative;
  }

  .terminal-card::after {
    animation: scanLine 6s linear infinite;
    background: linear-gradient(180deg, transparent, rgba(55, 224, 160, 0.08), transparent);
    content: "";
    inset: 0;
    pointer-events: none;
    position: absolute;
  }

  .terminal-top {
    align-items: center;
    background: rgba(255, 255, 255, 0.05);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    gap: 8px;
    min-height: 44px;
    padding: 0 16px;
  }

  .terminal-top span {
    border-radius: 999px;
    height: 10px;
    width: 10px;
  }

  .terminal-top span:nth-child(1) {
    background: #ff6d4d;
  }

  .terminal-top span:nth-child(2) {
    background: #ffcb57;
  }

  .terminal-top span:nth-child(3) {
    background: var(--mint);
  }

  .terminal-top strong {
    color: var(--mint);
    font-size: 12px;
    font-weight: 700;
    margin-left: auto;
  }

  .terminal-body {
    padding: 20px 22px 26px;
  }

  .terminal-body p {
    color: #f4fbf6;
    font-size: 15px;
    line-height: 1.7;
    margin: 0;
  }

  .terminal-body span {
    color: var(--mint);
    margin-right: 12px;
  }

  .section-head {
    margin-bottom: 34px;
    max-width: 760px;
  }

  .metric-grid {
    border: 1px solid var(--line);
    border-radius: 8px;
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    overflow: hidden;
  }

  .metric-grid article {
    background: color-mix(in srgb, var(--surface), transparent 8%);
    border-right: 1px solid var(--line);
    min-height: 260px;
    padding: 28px;
  }

  .metric-grid article:last-child {
    border-right: 0;
  }

  .metric-grid span {
    color: var(--muted);
    font-size: 12px;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .metric-grid strong {
    color: var(--ink);
    display: block;
    font-size: clamp(38px, 6vw, 76px);
    line-height: 1;
    margin-top: 24px;
  }

  .metric-grid p {
    color: var(--muted);
    line-height: 1.6;
    margin-top: 26px;
  }

  .cta-section {
    border-bottom: 1px solid var(--line);
    border-top: 1px solid var(--line);
    margin-top: 70px;
    overflow: hidden;
    position: relative;
  }

  .pattern {
    background-image: radial-gradient(rgba(55, 224, 160, 0.42) 1px, transparent 1px);
    background-size: 32px 32px;
    inset: 0;
    opacity: 0.18;
    position: absolute;
  }

  .cta-inner {
    padding: 110px 20px;
    position: relative;
    text-align: center;
  }

  .cta-inner p {
    margin-left: auto;
    margin-right: auto;
    max-width: 640px;
  }

  @media (max-width: 960px) {
    .workflow-grid,
    .metric-grid {
      grid-template-columns: 1fr;
    }

    .metric-grid article,
    .metric-grid article:last-child {
      border-bottom: 1px solid var(--line);
      border-right: 0;
      min-height: 210px;
    }

    .metric-grid article:last-child {
      border-bottom: 0;
    }

    .verb-grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (max-width: 560px) {
    .hero {
      min-height: auto;
    }

    .hero-inner {
      min-height: auto;
      padding-bottom: 80px;
      padding-top: 58px;
    }

    .verb-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .workflow-section,
    .metrics-section {
      padding: 70px 0;
    }
  }
</style>
