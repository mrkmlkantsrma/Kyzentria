---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="PDF Tools - Kyzentria" description="Inspect PDF file size, type, and sharing readiness with Kyzentria PDF tools.">
  <section class="shell tool-page">
    <div class="tool-intro">
      <p class="tool-kicker">PDF</p>
      <h1 class="tool-title">PDF file inspector.</h1>
      <span class="tool-lede">Check PDF size, type, and sharing readiness before sending or uploading a document.</span>
    </div>

    <div class="tool-layout">
      <section class="tool-surface">
        <div class="tool-header">
          <h2>PDF Check</h2>
          <span class="tool-badge">No upload</span>
        </div>
        <label class="tool-field">
          <span>PDF file</span>
          <input id="pdf-file" class="focus-ring" type="file" accept="application/pdf,.pdf" />
        </label>
        <div class="result-box">
          <span>File Summary</span>
          <strong id="pdf-size">Choose PDF</strong>
          <p id="pdf-note">The file stays on your device.</p>
        </div>
        <div class="preview-box">
          <strong>Checklist</strong>
          <p id="pdf-checklist" class="muted-copy">Select a PDF to see recommendations.</p>
        </div>
      </section>

      <aside class="tool-aside">
        <h2>Next PDF tools</h2>
        <p>Later this route can add image-to-PDF, merge, split, and compression using browser libraries.</p>
        <div class="note-list">
          <span>Document traffic</span>
          <span>Affiliate fit</span>
          <span>High utility</span>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline>
    const pdfFile = document.getElementById("pdf-file");
    const pdfSize = document.getElementById("pdf-size");
    const pdfNote = document.getElementById("pdf-note");
    const checklist = document.getElementById("pdf-checklist");

    pdfFile.addEventListener("change", () => {
      const file = pdfFile.files[0];
      if (!file) return;
      const mb = file.size / 1024 / 1024;
      pdfSize.textContent = `${mb.toFixed(2)} MB`;
      pdfNote.textContent = `${file.name} (${file.type || "PDF file"})`;
      const items = [];
      items.push(mb <= 5 ? "Good for email attachments." : "Consider compressing before email.");
      items.push(mb <= 20 ? "Usually acceptable for web uploads." : "Large file: upload may be slow.");
      items.push(file.name.toLowerCase().endsWith(".pdf") ? "File extension looks correct." : "Rename with .pdf if needed.");
      checklist.textContent = items.join(" ");
    });
  </script>
</BaseLayout>
