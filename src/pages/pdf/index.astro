---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="PDF Tools - Kyzentria" description="Simple PDF tools for converting, compressing, organizing, and preparing documents in the browser.">
  <section class="shell route-page">
    <p>PDF</p>
    <h1>Document tools for everyday files.</h1>
    <div class="route-grid">
      <article><h2>Convert</h2><span>PDF to image, image to PDF, office formats.</span></article>
      <article><h2>Compress</h2><span>Reduce file size without confusion.</span></article>
      <article><h2>Organize</h2><span>Merge, split, rotate, and reorder.</span></article>
    </div>
  </section>
</BaseLayout>

<style>
  .route-page { padding: 70px 20px 20px; }
  p { color: var(--coral); font-size: 13px; font-weight: 850; margin: 0 0 12px; text-transform: uppercase; }
  h1 { font-size: clamp(38px, 7vw, 72px); letter-spacing: 0; line-height: 1; margin: 0 0 36px; max-width: 820px; }
  .route-grid { display: grid; gap: 14px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  article { background: white; border: 1px solid var(--line); border-radius: 8px; padding: 22px; }
  h2 { margin: 0 0 10px; }
  span { color: var(--muted); }
  @media (max-width: 760px) { .route-grid { grid-template-columns: 1fr; } }
</style>
