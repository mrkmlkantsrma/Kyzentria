---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Developer Tools - Kyzentria" description="Format, validate, and inspect JSON in your browser with Kyzentria developer tools.">
  <section class="shell tool-page">
    <div class="tool-intro">
      <p class="tool-kicker">Developer</p>
      <h1 class="tool-title">JSON formatter and validator.</h1>
      <span class="tool-lede">Paste JSON to format, minify, validate, and inspect size without sending data anywhere.</span>
    </div>

    <div class="tool-layout">
      <section class="tool-surface">
        <div class="tool-header">
          <h2>JSON Tool</h2>
          <span class="tool-badge">Browser only</span>
        </div>
        <label class="tool-field">
          <span>JSON input</span>
          <textarea id="json-input" class="focus-ring">{`{ "brand": "Kyzentria", "tools": ["calculator", "seo", "json"] }`}</textarea>
        </label>
        <div class="button-row">
          <button id="format-json" class="tool-button focus-ring" type="button">Format</button>
          <button id="minify-json" class="tool-button secondary focus-ring" type="button">Minify</button>
        </div>
        <div class="result-box">
          <span id="json-status">Valid JSON</span>
          <strong id="json-size">72 chars</strong>
          <p id="json-note">Formatted JSON will appear in the input box.</p>
        </div>
      </section>

      <aside class="tool-aside">
        <h2>Next tools</h2>
        <p>Developer pages can grow into JSON compare, text cleaner, QR generator, password generator, and meta tag tools.</p>
        <div class="note-list">
          <span>No API required</span>
          <span>Good repeat usage</span>
          <span>Easy internal links</span>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline>
    const input = document.getElementById("json-input");
    const status = document.getElementById("json-status");
    const size = document.getElementById("json-size");
    const note = document.getElementById("json-note");

    function updateJson(mode) {
      try {
        const parsed = JSON.parse(input.value);
        input.value = mode === "minify" ? JSON.stringify(parsed) : JSON.stringify(parsed, null, 2);
        status.textContent = "Valid JSON";
        size.textContent = `${input.value.length.toLocaleString()} chars`;
        note.textContent = mode === "minify" ? "JSON has been minified." : "JSON has been formatted with two-space indentation.";
      } catch (error) {
        status.textContent = "Invalid JSON";
        size.textContent = "Check input";
        note.textContent = error.message;
      }
    }

    document.getElementById("format-json").addEventListener("click", () => updateJson("format"));
    document.getElementById("minify-json").addEventListener("click", () => updateJson("minify"));
    input.addEventListener("input", () => {
      size.textContent = `${input.value.length.toLocaleString()} chars`;
    });
    updateJson("format");
  </script>
</BaseLayout>

<style>
  .button-row {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 14px;
  }
</style>
