---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Comparison Tools - Kyzentria" description="Clear software and service comparisons for smarter buying decisions.">
  <section class="shell route-page">
    <p>Compare</p>
    <h1>Comparison pages built for decisions.</h1>
    <div class="route-grid">
      <article><h2>Software</h2><span>AI, design, productivity, SEO.</span></article>
      <article><h2>Hosting</h2><span>Pricing, features, speed, support.</span></article>
      <article><h2>Tools</h2><span>Plain pros, cons, and best use cases.</span></article>
    </div>
  </section>
</BaseLayout>

<style>
  .route-page { padding: 70px 20px 20px; }
  p { color: var(--coral); font-size: 13px; font-weight: 850; margin: 0 0 12px; text-transform: uppercase; }
  h1 { font-size: clamp(38px, 7vw, 72px); letter-spacing: 0; line-height: 1; margin: 0 0 36px; max-width: 820px; }
  .route-grid { display: grid; gap: 14px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  article { background: white; border: 1px solid var(--line); border-radius: 8px; padding: 22px; }
  h2 { margin: 0 0 10px; }
  span { color: var(--muted); }
  @media (max-width: 760px) { .route-grid { grid-template-columns: 1fr; } }
</style>
