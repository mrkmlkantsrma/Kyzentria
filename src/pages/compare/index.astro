---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Comparison Tools - Kyzentria" description="Score two tools or services by price, features, ease, support, and value.">
  <section class="shell tool-page">
    <div class="tool-intro">
      <p class="tool-kicker">Compare</p>
      <h1 class="tool-title">Simple comparison scorer.</h1>
      <span class="tool-lede">Score two options and get a quick winner for software, hosting, tools, or services.</span>
    </div>

    <div class="tool-layout">
      <section class="tool-surface">
        <div class="tool-header">
          <h2>Compare Two Options</h2>
          <span class="tool-badge">Decision helper</span>
        </div>
        <div class="field-grid">
          <label class="tool-field"><span>Option A</span><input id="name-a" class="focus-ring" value="Tool A" /></label>
          <label class="tool-field"><span>Option B</span><input id="name-b" class="focus-ring" value="Tool B" /></label>
        </div>
        <div id="score-grid" class="score-grid"></div>
        <div class="result-box">
          <span>Winner</span>
          <strong id="winner">Tie</strong>
          <p id="score-note">Adjust scores from 1 to 5.</p>
        </div>
      </section>

      <aside class="tool-aside">
        <h2>Money pages</h2>
        <p>Comparison pages can become high-intent SEO pages with honest pros, cons, tables, and affiliate links.</p>
        <div class="note-list">
          <span>High buying intent</span>
          <span>Affiliate friendly</span>
          <span>Internal-link hub</span>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline>
    const factors = ["Price", "Features", "Ease", "Support", "Value"];
    const grid = document.getElementById("score-grid");
    const winner = document.getElementById("winner");
    const note = document.getElementById("score-note");
    const nameA = document.getElementById("name-a");
    const nameB = document.getElementById("name-b");

    grid.innerHTML = factors.map((factor, index) => `
      <label class="tool-field"><span>${factor} - A</span><input class="score-a focus-ring" type="number" min="1" max="5" value="${index === 0 ? 4 : 3}"></label>
      <label class="tool-field"><span>${factor} - B</span><input class="score-b focus-ring" type="number" min="1" max="5" value="3"></label>
    `).join("");

    function total(selector) {
      return [...document.querySelectorAll(selector)].reduce((sum, input) => sum + Number(input.value || 0), 0);
    }

    function updateCompare() {
      const a = total(".score-a");
      const b = total(".score-b");
      winner.textContent = a === b ? "Tie" : a > b ? nameA.value : nameB.value;
      note.textContent = `${nameA.value}: ${a}/25. ${nameB.value}: ${b}/25.`;
    }

    document.querySelectorAll("input").forEach((input) => input.addEventListener("input", updateCompare));
    updateCompare();
  </script>
</BaseLayout>

<style>
  .score-grid {
    display: grid;
    gap: 12px;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    margin-top: 16px;
  }

  @media (max-width: 700px) {
    .score-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
