---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Prompt Tools - Kyzentria" description="Build reusable prompts for writing, coding, research, SEO, and planning with Kyzentria.">
  <section class="shell tool-page">
    <div class="tool-intro">
      <p class="tool-kicker">Prompt</p>
      <h1 class="tool-title">Prompt builder for repeatable work.</h1>
      <span class="tool-lede">Choose a task, add context, and generate a structured prompt you can reuse.</span>
    </div>

    <div class="tool-layout">
      <section class="tool-surface">
        <div class="tool-header">
          <h2>Prompt Builder</h2>
          <span class="tool-badge">AI workflow</span>
        </div>
        <div class="field-grid">
          <label class="tool-field">
            <span>Task type</span>
            <select id="prompt-task" class="focus-ring">
              <option>Write SEO content</option>
              <option>Improve code</option>
              <option>Compare tools</option>
              <option>Create checklist</option>
            </select>
          </label>
          <label class="tool-field">
            <span>Tone</span>
            <select id="prompt-tone" class="focus-ring">
              <option>Clear and practical</option>
              <option>Professional</option>
              <option>Friendly</option>
              <option>Concise</option>
            </select>
          </label>
        </div>
        <label class="tool-field solo">
          <span>Context</span>
          <textarea id="prompt-context" class="focus-ring">I am building Kyzentria, a free static website with useful browser tools.</textarea>
        </label>
        <button id="copy-prompt" class="tool-button focus-ring" type="button">Copy prompt</button>
        <div class="preview-box">
          <pre id="prompt-output"></pre>
        </div>
      </section>

      <aside class="tool-aside">
        <h2>Monetization fit</h2>
        <p>Prompt pages can later include template packs, comparison pages, and affiliate links for AI tools.</p>
        <div class="note-list">
          <span>High repeat usage</span>
          <span>Easy templates</span>
          <span>Good for AI traffic</span>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline>
    const task = document.getElementById("prompt-task");
    const tone = document.getElementById("prompt-tone");
    const context = document.getElementById("prompt-context");
    const output = document.getElementById("prompt-output");
    const copy = document.getElementById("copy-prompt");

    function updatePrompt() {
      output.textContent = `Act as an expert assistant.\n\nTask: ${task.value}\nTone: ${tone.value}\nContext: ${context.value.trim()}\n\nRequirements:\n- Ask clarifying questions only if required.\n- Give practical steps.\n- Keep the answer easy to scan.\n- Include examples where useful.`;
    }

    [task, tone, context].forEach((item) => item.addEventListener("input", updatePrompt));
    copy.addEventListener("click", async () => {
      await navigator.clipboard.writeText(output.textContent);
      copy.textContent = "Copied";
      setTimeout(() => (copy.textContent = "Copy prompt"), 1200);
    });
    updatePrompt();
  </script>
</BaseLayout>

<style>
  .solo {
    margin-top: 14px;
  }

  .tool-button {
    margin-top: 14px;
  }

  pre {
    overflow: auto;
    white-space: pre-wrap;
  }
</style>
