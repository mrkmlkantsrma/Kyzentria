---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Hosting Guides - Kyzentria" description="Estimate hosting costs and compare monthly, yearly, domain, and add-on pricing.">
  <section class="shell tool-page">
    <div class="tool-intro">
      <p class="tool-kicker">Hosting</p>
      <h1 class="tool-title">Hosting cost estimator.</h1>
      <span class="tool-lede">Estimate first-year and monthly hosting costs before choosing a plan.</span>
    </div>

    <div class="tool-layout">
      <section class="tool-surface">
        <div class="tool-header">
          <h2>Cost Calculator</h2>
          <span class="tool-badge">Affiliate-ready</span>
        </div>
        <div class="field-grid">
          <label class="tool-field"><span>Monthly hosting</span><input id="host-monthly" class="focus-ring" type="number" value="5" step="0.01" /></label>
          <label class="tool-field"><span>Domain per year</span><input id="domain-yearly" class="focus-ring" type="number" value="12" step="0.01" /></label>
          <label class="tool-field"><span>Email per month</span><input id="email-monthly" class="focus-ring" type="number" value="0" step="0.01" /></label>
          <label class="tool-field"><span>Other add-ons per month</span><input id="addons-monthly" class="focus-ring" type="number" value="3" step="0.01" /></label>
        </div>
        <div class="result-box">
          <span>Estimated Cost</span>
          <strong id="yearly-cost">$108.00</strong>
          <p id="monthly-cost">$9.00 average per month including yearly domain cost.</p>
        </div>
      </section>

      <aside class="tool-aside">
        <h2>Content ideas</h2>
        <p>This route can grow into best hosting for beginners, static site hosting, domain comparison, and launch checklists.</p>
        <div class="note-list">
          <span>Strong affiliate intent</span>
          <span>Useful calculator</span>
          <span>Good SEO cluster</span>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline>
    const ids = ["host-monthly", "domain-yearly", "email-monthly", "addons-monthly"];
    const yearly = document.getElementById("yearly-cost");
    const monthly = document.getElementById("monthly-cost");

    function money(value) {
      return new Intl.NumberFormat("en", { style: "currency", currency: "USD" }).format(value);
    }

    function updateHosting() {
      const values = Object.fromEntries(ids.map((id) => [id, Number(document.getElementById(id).value || 0)]));
      const year = (values["host-monthly"] + values["email-monthly"] + values["addons-monthly"]) * 12 + values["domain-yearly"];
      yearly.textContent = money(year);
      monthly.textContent = `${money(year / 12)} average per month including yearly domain cost.`;
    }

    ids.forEach((id) => document.getElementById(id).addEventListener("input", updateHosting));
    updateHosting();
  </script>
</BaseLayout>
