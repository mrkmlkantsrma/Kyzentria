---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="Image Tools - Kyzentria" description="Resize and compress images in your browser with Kyzentria image tools.">
  <section class="shell tool-page">
    <div class="tool-intro">
      <p class="tool-kicker">Image</p>
      <h1 class="tool-title">Image resize and compress.</h1>
      <span class="tool-lede">Upload an image, set a max width, and export a smaller JPEG directly in your browser.</span>
    </div>

    <div class="tool-layout">
      <section class="tool-surface">
        <div class="tool-header">
          <h2>Image Optimizer</h2>
          <span class="tool-badge">Local file</span>
        </div>
        <div class="field-grid">
          <label class="tool-field">
            <span>Image file</span>
            <input id="image-file" class="focus-ring" type="file" accept="image/*" />
          </label>
          <label class="tool-field">
            <span>Max width</span>
            <input id="image-width" class="focus-ring" type="number" value="1200" min="100" step="50" />
          </label>
        </div>
        <label class="tool-field solo">
          <span>Quality</span>
          <input id="image-quality" class="focus-ring" type="range" value="80" min="30" max="95" />
        </label>
        <button id="process-image" class="tool-button focus-ring" type="button">Optimize image</button>
        <canvas id="image-canvas" hidden></canvas>
        <div class="result-box">
          <span>Output</span>
          <strong id="image-result">Ready</strong>
          <p id="image-note">Choose an image to create an optimized JPEG.</p>
        </div>
        <a id="download-image" class="download-link focus-ring" href="#" download="kyzentria-image.jpg" hidden>Download optimized image</a>
      </section>

      <aside class="tool-aside">
        <h2>Good first tool</h2>
        <p>Image tools attract creator, website, ecommerce, and SEO traffic. More formats can come later.</p>
        <div class="note-list">
          <span>Runs in browser</span>
          <span>No upload server</span>
          <span>SEO content friendly</span>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline>
    const fileInput = document.getElementById("image-file");
    const widthInput = document.getElementById("image-width");
    const qualityInput = document.getElementById("image-quality");
    const canvas = document.getElementById("image-canvas");
    const result = document.getElementById("image-result");
    const note = document.getElementById("image-note");
    const download = document.getElementById("download-image");

    document.getElementById("process-image").addEventListener("click", () => {
      const file = fileInput.files[0];
      if (!file) {
        result.textContent = "No file";
        note.textContent = "Select an image first.";
        return;
      }
      const img = new Image();
      img.onload = () => {
        const maxWidth = Number(widthInput.value || 1200);
        const scale = Math.min(1, maxWidth / img.width);
        canvas.width = Math.round(img.width * scale);
        canvas.height = Math.round(img.height * scale);
        canvas.getContext("2d").drawImage(img, 0, 0, canvas.width, canvas.height);
        const quality = Number(qualityInput.value) / 100;
        const url = canvas.toDataURL("image/jpeg", quality);
        download.href = url;
        download.hidden = false;
        const estimatedKb = Math.round((url.length * 0.75) / 1024);
        result.textContent = `${canvas.width}x${canvas.height}`;
        note.textContent = `Estimated output size: ${estimatedKb.toLocaleString()} KB.`;
      };
      img.src = URL.createObjectURL(file);
    });
  </script>
</BaseLayout>

<style>
  .solo,
  .tool-button {
    margin-top: 14px;
  }

  .download-link {
    display: inline-flex;
    font-weight: 850;
    margin-top: 16px;
  }
</style>
