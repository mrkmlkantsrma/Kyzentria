---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="SEO Tools - Kyzentria" description="Preview titles and meta descriptions with simple SEO checks from Kyzentria.">
  <section class="shell tool-page">
    <div class="tool-intro">
      <p class="tool-kicker">SEO</p>
      <h1 class="tool-title">Search snippet preview.</h1>
      <span class="tool-lede">Write a page title and meta description, then check length and preview how it may look in search.</span>
    </div>

    <div class="tool-layout">
      <section class="tool-surface">
        <div class="tool-header">
          <h2>Meta Preview</h2>
          <span class="tool-badge">SEO basics</span>
        </div>
        <div class="field-grid">
          <label class="tool-field">
            <span>Page title</span>
            <input id="seo-title" class="focus-ring" value="Kyzentria - Smart tools for everyday work" />
          </label>
          <label class="tool-field">
            <span>Page URL</span>
            <input id="seo-url" class="focus-ring" value="https://kyzentria.pages.dev/calculator" />
          </label>
        </div>
        <label class="tool-field solo">
          <span>Meta description</span>
          <textarea id="seo-description" class="focus-ring">Free browser tools for calculators, PDFs, images, SEO, resumes, comparisons, prompts, hosting, and developer tasks.</textarea>
        </label>
        <div class="preview-box search-preview">
          <cite id="preview-url">https://kyzentria.pages.dev/calculator</cite>
          <h2 id="preview-title">Kyzentria - Smart tools for everyday work</h2>
          <p id="preview-description">Free browser tools for calculators, PDFs, images, SEO, resumes, comparisons, prompts, hosting, and developer tasks.</p>
        </div>
        <div class="result-box">
          <span>Length Check</span>
          <strong id="seo-score">Good</strong>
          <p id="seo-note">Title and description are in a usable range.</p>
        </div>
      </section>

      <aside class="tool-aside">
        <h2>SEO rule</h2>
        <p>Each Kyzentria tool should target one clear search intent and link naturally to related routes.</p>
        <div class="note-list">
          <span>Title: 35-60 chars</span>
          <span>Description: 90-160 chars</span>
          <span>One page, one intent</span>
        </div>
      </aside>
    </div>
  </section>

  <script is:inline>
    const titleInput = document.getElementById("seo-title");
    const urlInput = document.getElementById("seo-url");
    const descInput = document.getElementById("seo-description");
    const previewTitle = document.getElementById("preview-title");
    const previewUrl = document.getElementById("preview-url");
    const previewDesc = document.getElementById("preview-description");
    const score = document.getElementById("seo-score");
    const note = document.getElementById("seo-note");

    function updateSeo() {
      const title = titleInput.value.trim();
      const desc = descInput.value.trim();
      previewTitle.textContent = title || "Untitled page";
      previewUrl.textContent = urlInput.value.trim() || "https://example.com";
      previewDesc.textContent = desc || "Add a useful description for this page.";
      const titleOk = title.length >= 35 && title.length <= 60;
      const descOk = desc.length >= 90 && desc.length <= 160;
      score.textContent = titleOk && descOk ? "Good" : "Needs work";
      note.textContent = `Title: ${title.length} chars. Description: ${desc.length} chars.`;
    }

    [titleInput, urlInput, descInput].forEach((item) => item.addEventListener("input", updateSeo));
    updateSeo();
  </script>
</BaseLayout>

<style>
  .solo {
    margin-top: 14px;
  }

  .search-preview cite {
    color: #1f7a42;
    font-style: normal;
  }

  .search-preview h2 {
    color: #1a0dab;
    font-size: 22px;
    margin: 8px 0;
  }

  .search-preview p {
    color: #4d5156;
    line-height: 1.45;
    margin: 0;
  }
</style>
