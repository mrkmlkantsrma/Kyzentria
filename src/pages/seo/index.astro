---
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout title="SEO Tools - Kyzentria" description="Simple SEO checks for titles, descriptions, headings, metadata, and page planning.">
  <section class="shell route-page">
    <p>SEO</p>
    <h1>SEO helpers for clearer pages.</h1>
    <div class="route-grid">
      <article><h2>Metadata</h2><span>Titles, descriptions, previews.</span></article>
      <article><h2>Content</h2><span>Headings, intent, internal links.</span></article>
      <article><h2>Technical</h2><span>Sitemap, robots, status checks.</span></article>
    </div>
  </section>
</BaseLayout>

<style>
  .route-page { padding: 70px 20px 20px; }
  p { color: var(--coral); font-size: 13px; font-weight: 850; margin: 0 0 12px; text-transform: uppercase; }
  h1 { font-size: clamp(38px, 7vw, 72px); letter-spacing: 0; line-height: 1; margin: 0 0 36px; max-width: 820px; }
  .route-grid { display: grid; gap: 14px; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  article { background: white; border: 1px solid var(--line); border-radius: 8px; padding: 22px; }
  h2 { margin: 0 0 10px; }
  span { color: var(--muted); }
  @media (max-width: 760px) { .route-grid { grid-template-columns: 1fr; } }
</style>
